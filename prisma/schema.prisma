generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shipment {
  id                String         @id @default(cuid())
  trackingId        String         @unique
  status            String         @default("pending") // 'delivered' | 'in_transit' | 'pending' | 'customs_hold'
  serviceType       String
  shipper           String
  recipient         String
  origin            String
  destination       String
  estimatedDelivery String
  currentStep       Int            @default(1)
  weight            String?
  packageType       String?
  bookedAt          String?
  steps             TrackingStep[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model TrackingStep {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String
  timestamp  String
  details    String
  completed  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

model ContactInquiry {
  id          String   @id @default(cuid())
  referenceId String   @unique
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  createdAt   DateTime @default(now())
}
